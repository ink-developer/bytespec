msgstr "Интерфейс записи и чтения одного значения типа T."

msgid ":py:obj:`bytespec.BytespecError <bytespec.BytespecError>`\\"
msgstr ":py:obj:`bytespec.BytespecError <bytespec.BytespecError>`\\"

msgid "Common base class for schema, encoding, and decoding errors."
msgstr "Общий базовый класс ошибок схемы, кодирования и декодирования."

msgid "str(object='') -> str str(bytes_or_buffer[, encoding[, errors]]) -> str"
msgstr "str(object='') -> str str(bytes_or_buffer[, encoding[, errors]]) -> str"

msgid ""
"Create a new string object from the given object. If encoding or errors is specified, then the "
"object must expose a data buffer that will be decoded using the given encoding and error handler."
" Otherwise, returns the result of object.__str__() (if defined) or repr(object). encoding "
"defaults to 'utf-8'. errors defaults to 'strict'."
msgstr ""
"Create a new string object from the given object. If encoding or errors is specified, then the "
"object must expose a data buffer that will be decoded using the given encoding and error handler."
" Otherwise, returns the result of object.__str__() (if defined) or repr(object). encoding "
"defaults to 'utf-8'. errors defaults to 'strict'."

